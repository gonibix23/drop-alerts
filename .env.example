# Copia a .env. No subas el archivo .env ni secretos al repositorio.
DISCORD_WEBHOOK_URL=
# Alternativa: ruta dentro del contenedor a un secreto montado, nunca ruta del host.
DISCORD_WEBHOOK_URL_FILE=
# Webhooks opcionales de canales distintos por juego; tienen prioridad sobre el general.
# El general recibe juegos sin webhook específico y contenido sin juego identificado.
DISCORD_WEBHOOK_URL_MAGIC=
DISCORD_WEBHOOK_URL_ONE_PIECE=
DISCORD_WEBHOOK_URL_POKEMON=
# Alternativas por archivo de secreto (deja vacía la variable directa correspondiente).
DISCORD_WEBHOOK_URL_MAGIC_FILE=
DISCORD_WEBHOOK_URL_ONE_PIECE_FILE=
DISCORD_WEBHOOK_URL_POKEMON_FILE=
POLL_INTERVAL_SECONDS=300
# Fuentes, reglas e intervalos propios se configuran en config.example.toml.
# Anuncios de Magic, One Piece y Pokémon, y calendarios locales configurables.
# Las tiendas también respetan estos juegos; puedes añadir riftbound,lorcana,dragon_ball,etc.
ENABLED_TCGS=magic,one_piece,pokemon
TIMEZONE=Europe/Madrid
BOOTSTRAP_MODE=silent
DATABASE_PATH=/data/drop-alerts.db
HEARTBEAT_PATH=/data/heartbeat.json
LOG_LEVEL=INFO
CONFIG_PATH=/app/config.toml
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=1
SOURCE_MAX_BYTES=2000000
SOURCE_MAX_ITEMS=100

# Cliente HTTP al servidor externo: el modelo no se ejecuta en este contenedor.
LLM_ENABLED=true
LLM_BASE_URL=https://llama.gonibix23.com/v1
LLM_MODEL=qwen3:8b-q4_k_m
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_INPUT_CHARS=12000
LLM_CACHE_ENABLED=true
LLM_MAX_OUTPUT_TOKENS=1200
MAX_PENDING_ANALYSES=100
ANALYSES_PER_TICK=4
ANALYSIS_MAX_ATTEMPTS=3
NOTIFICATION_MAX_ATTEMPTS=12
NOTIFICATION_BATCH_SIZE=10
RETENTION_DAYS=90
