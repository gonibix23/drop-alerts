# Copia a .env. No subas el archivo .env ni secretos al repositorio.
DROP_ALERTS_IMAGE=drop-alerts:1.0.0
DISCORD_WEBHOOK_URL=
# Alternativa: ruta dentro del contenedor a un secreto montado, nunca ruta del host.
DISCORD_WEBHOOK_URL_FILE=
POLL_INTERVAL_SECONDS=300
TIMEZONE=Europe/Madrid
BOOTSTRAP_MODE=silent
DATABASE_PATH=/data/drop-alerts.db
HEARTBEAT_PATH=/data/heartbeat.json
LOG_LEVEL=INFO
CONFIG_PATH=/app/config.toml
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=1
SOURCE_MAX_BYTES=2000000
SOURCE_MAX_ITEMS=100

# Cliente HTTP al servidor externo: el modelo no se ejecuta en este contenedor.
LLM_ENABLED=true
LLM_BASE_URL=https://llama.gonibix23.com/v1
LLM_MODEL=qwen3:8b-q4_k_m
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_INPUT_CHARS=12000
LLM_CACHE_ENABLED=true
LLM_MAX_OUTPUT_TOKENS=1200
MAX_PENDING_ANALYSES=100
ANALYSES_PER_TICK=4
ANALYSIS_MAX_ATTEMPTS=3
NOTIFICATION_MAX_ATTEMPTS=12
NOTIFICATION_BATCH_SIZE=10
RETENTION_DAYS=90
